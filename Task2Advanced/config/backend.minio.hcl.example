# Пример backend для локального MinIO (скопируйте в envs/<env>/backend.hcl)
# cp config/backend.minio.hcl.example envs/dev/backend.hcl
# и измените key на envs/dev/terraform.tfstate

bucket                      = "budushee-terraform-state"
key                         = "envs/dev/terraform.tfstate"
region                      = "us-east-1"
endpoints                   = { s3 = "http://127.0.0.1:9000" }
skip_credentials_validation = true
skip_metadata_api_check     = true
skip_region_validation      = true
skip_requesting_account_id  = true
skip_s3_checksum            = true
use_path_style              = true
